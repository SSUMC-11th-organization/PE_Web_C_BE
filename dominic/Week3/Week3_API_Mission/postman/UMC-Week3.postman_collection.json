{
  "info": {
    "name": "UMC 3주차 - NestJS 도서 대여 API",
    "description": "NestJS 3계층 구조, DTO/ORM 없이 Raw SQL. 필수 2개·선택 1개와 기본 실습 2개. GET → POST → 응답 객체의 rental_id를 Collection Variables에 입력 → PATCH 순서로 실행합니다. POST와 PATCH는 실제 DB를 변경합니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000", "type": "string" },
    { "key": "categoryId", "value": "1", "type": "string" },
    { "key": "userId", "value": "1", "type": "string" },
    { "key": "bookId", "value": "4", "type": "string" },
    { "key": "rentalId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "기본 실습 1 - 전체 도서 조회",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books"
      }
    },
    {
      "name": "기본 실습 2 - 도서 등록",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"title\": \"클린 코드\",\n  \"description\": \"애자일 소프트웨어 장인 정신\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "새 책을 생성합니다. 반복 요청하면 책이 계속 추가됩니다. 응답의 book_id를 대여 요청의 bookId로 사용할 수 있습니다."
      }
    },
    {
      "name": "DB 연결 상태",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "필수 1 — 카테고리별 도서 조회",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books/category/{{categoryId}}",
        "description": "categoryId를 경로 변수로 전달합니다. 대여 가능 여부에 관계없이 해당 카테고리의 모든 책을 반환합니다."
      }
    },
    {
      "name": "필수 2 — 신규 도서 대여",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/rentals",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{userId}},\n  \"bookId\": {{bookId}}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "userId와 bookId는 JSON 숫자입니다. 응답 객체의 rental_id를 Collection Variables의 rentalId에 입력하세요. 새 DB에는 책 4가 없으므로 도서 등록 응답의 book_id 또는 대여 가능한 기존 ID를 사용하세요."
      }
    },
    {
      "name": "선택 — 도서 반납",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/rentals/{{rentalId}}/return",
        "description": "Collection Variables의 rentalId에 POST 응답에서 복사한 값을 설정하세요. Request Body 없이 반납 시각을 NOW()로 갱신합니다."
      }
    }
  ]
}
