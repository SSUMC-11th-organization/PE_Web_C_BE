          }
        ],
        "url": "{{baseUrl}}/movie-records",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 238,\n  \"score\": 5,\n  \"comment\": \"다시 보고 싶은 영화입니다.\",\n  \"addToFavorites\": true\n}",
