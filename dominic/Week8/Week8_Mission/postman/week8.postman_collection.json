              "const responseData=pm.response.json();",
              "pm.test('code COMMON200',()=>pm.expect(responseData.code).to.eql('COMMON200'));",
              "pm.collectionVariables.set('tokenA',responseData.result.accessToken);"
            ]
          }
        }
      ]
    },
