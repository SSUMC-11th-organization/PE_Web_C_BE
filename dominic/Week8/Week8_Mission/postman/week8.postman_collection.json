{
  "info": {
    "name": "UMC Week 8 즐겨찾기와 트랜잭션",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3007"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run')) { const run=Date.now().toString(); pm.collectionVariables.set('run',run); for(const who of ['A','B']) { pm.collectionVariables.set('email'+who,'postman8'+run+who+'@example.com'); pm.collectionVariables.set('nickname'+who,who+'p'+run.slice(-8)); } }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "회원 A 가입",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"nickname\": \"{{nicknameA}}\",\n  \"password\": \"Study!1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const responseData=pm.response.json();",
              "pm.test('code COMMON201',()=>pm.expect(responseData.code).to.eql('COMMON201'));"
            ]
          }
        }
      ]
    },
    {
      "name": "회원 A 로그인",
      "request": {
        "method": "POST",
        "header": [
          {
