              "const responseData=pm.response.json();",
              "pm.test('code COMMON201',()=>pm.expect(responseData.code).to.eql('COMMON201'));",
              "pm.test('both saved',()=>{pm.expect(responseData.result.rating.movieId).to.eql(238);pm.expect(responseData.result.favorite.movieId).to.eql(238);});"
            ]
          }
