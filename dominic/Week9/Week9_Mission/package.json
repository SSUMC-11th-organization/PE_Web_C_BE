{
  "name": "umc-week9-movie-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "npm run build && node --env-file-if-exists=.env dist/main.js",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.cjs",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:scenario": "npx --yes newman@6.2.3 run postman/week9.postman_collection.json --bail",
    "test:e2e": "jest --config test/jest-e2e.cjs --runInBand",
    "test:all": "npm test && npm run test:e2e",
    "test:mysql": "npm run build && node --env-file-if-exists=.env --test test/*.test.cjs",
    "test:mutations": "node scripts/check-mutations.cjs",
    "evidence": "node scripts/create-evidence.cjs",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.9",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.9",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/typeorm": "11.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "mysql2": "3.24.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.9",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "@types/sql.js": "1.4.9",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "sql.js": "1.13.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  }
}
